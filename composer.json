{
    "name": "biscuit-studios/woo-exports",
    "description": "Private WooCommerce reporting plugin for agency use",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "phpoffice/phpspreadsheet": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.0"
    },
    "autoload-dev": {
        "psr-4": {
            "WooExports\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always tests/"
    },
    "config": {
        "vendor-dir": "vendor",
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        }
    }
}
